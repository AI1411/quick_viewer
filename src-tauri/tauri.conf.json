{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickView",
  "version": "2.0.0",
  "identifier": "dev.quickview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickView",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost https:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMUY3RDQ3QjRDODM2OEQKUldTTk5zaTBSMzBmSy9nVm9tVFNSNzZxdHJscUdQNlMrNW4rakUxQW82RjN6OWxBUkxaYWFDcnEK",
      "endpoints": [
        "https://github.com/AI1411/quick_viewer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "csv"
        ],
        "mimeType": "text/csv",
        "role": "Viewer"
      },
      {
        "ext": [
          "tsv"
        ],
        "mimeType": "text/tab-separated-values",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "role": "Viewer"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "mimeType": "text/markdown",
        "role": "Viewer"
      },
      {
        "ext": [
          "xlsx"
        ],
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "signingIdentity": null,
      "dmg": {
        "background": null,
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "createUpdaterArtifacts": true
  }
}
