<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID で署名して hardened runtime を有効にしたときに使われる (署名なしのビルドでは無視される)。
  - allow-unsigned-executable-memory は MAP_JIT なしの実行可能メモリを許し、hardened runtime を大きく弱めるため外した
  - files.user-selected.read-only は App Sandbox 有効時にしか意味が無いため外した
  - allow-jit は WebView の JIT 用に残している。署名したビルドで不要と確認できたら外してよい
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
